# Hidden / personal config files (.claude/, .vscode/, .idea/, .DS_Store, etc.)
.*

# Re-include the dotfiles that DO belong in the repo
!.gitignore
!.gitattributes

# OS
Thumbs.db

# KiCad lock/temp files
*.kicad_sch.lck
*.kicad_pcb.lck
*.kicad_pro.lck
~*.lck

# FreeCad backup files
*.FCBak

# STL files, so they don't have to be kept in sync with the FreeCad files
*.stl

# Flap scad custom presets
flaps.json
